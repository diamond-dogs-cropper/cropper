# Скопируйте в .env и задайте свои значения: docker compose без них не запустится.
POSTGRES_PASSWORD=
STORAGE_SECRET_KEY=

# Адрес сайта для ссылки в письме-приглашении.
PUBLIC_URL=http://localhost
# Письма уходят через Resend по SMTP. MAIL_PASSWORD — API-ключ Resend, MAIL_FROM — адрес
# на подтверждённом в Resend домене. Без них сайт работает, приглашения отвечают ошибкой.
MAIL_PASSWORD=
MAIL_FROM=
